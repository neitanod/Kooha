<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="libadwaita" version="1.0"/>
  <template class="KoohaPreferencesDialog" parent="AdwPreferencesDialog">
    <child>
      <object class="AdwPreferencesPage">
        <child>
          <object class="AdwPreferencesGroup">
            <property name="title" translatable="yes">General</property>
            <child>
              <object class="AdwSpinRow" id="delay_row">
                <property name="title" translatable="yes">Delay (Seconds)</property>
                <property name="subtitle" translatable="yes">Time interval before recording begins</property>
                <property name="adjustment">
                  <object class="GtkAdjustment">
                    <property name="lower">0</property>
                    <property name="upper">10</property>
                    <property name="step-increment">1</property>
                    <property name="page-increment">5</property>
                  </object>
                </property>
              </object>
            </child>
            <child>
              <object class="AdwActionRow">
                <property name="title" translatable="yes">Recordings Folder</property>
                <property name="subtitle" translatable="yes">Destination folder for the recordings</property>
                <property name="action-name">preferences.select-saving-location</property>
                <property name="activatable">True</property>
                <child type="suffix">
                  <object class="GtkLabel" id="file_chooser_label">
                    <property name="xalign">0</property>
                    <property name="ellipsize">middle</property>
                    <property name="max-width-chars">30</property>
                  </object>
                </child>
                <child type="suffix">
                  <object class="GtkImage">
                    <property name="valign">center</property>
                    <property name="icon-name">go-next-symbolic</property>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwPreferencesGroup">
            <property name="title" translatable="yes" context="preferences group">Recording</property>
            <child>
              <object class="AdwSwitchRow" id="pause_flash_row">
                <property name="title" translatable="yes">Flash on Resume</property>
                <property name="subtitle" translatable="yes">Mark each resume with a short white flash</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <!-- The title is set in code: it is markup and has an ampersand. -->
          <object class="AdwPreferencesGroup" id="camera_group">
            <child>
              <object class="AdwActionRow" id="overlays_warning_row">
                <property name="visible">False</property>
                <property name="title" translatable="yes">Overlays unavailable</property>
                <style>
                  <class name="warning"/>
                </style>
                <child type="prefix">
                  <object class="GtkImage">
                    <property name="icon-name">dialog-warning-symbolic</property>
                  </object>
                </child>
                <child type="suffix">
                  <object class="GtkButton" id="open_report_button">
                    <property name="valign">center</property>
                    <property name="label" translatable="yes">Open Report</property>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="AdwSwitchRow" id="camera_enabled_row">
                <property name="title" translatable="yes">Show Camera</property>
              </object>
            </child>
            <child>
              <object class="AdwComboRow" id="camera_source_row">
                <property name="title" translatable="yes">Camera Source</property>
              </object>
            </child>
            <child>
              <object class="AdwComboRow" id="camera_shape_row">
                <property name="title" translatable="yes">Camera Shape</property>
                <property name="subtitle" translatable="yes">Right-click the camera to switch</property>
                <property name="model">
                  <object class="GtkStringList">
                    <items>
                      <item translatable="yes">Circle</item>
                      <item translatable="yes">Rounded Rectangle</item>
                    </items>
                  </object>
                </property>
              </object>
            </child>
            <child>
              <object class="AdwComboRow" id="camera_monitor_row">
                <property name="title" translatable="yes">Camera Monitor</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwPreferencesGroup">
            <property name="title" translatable="yes">Video</property>
            <child>
              <object class="AdwComboRow" id="profile_row">
                <property name="title" translatable="yes">Format</property>
              </object>
            </child>
            <child>
              <object class="AdwComboRow" id="framerate_row">
                <property name="title" translatable="yes">Frame Rate</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </template>
</interface>
